[Desktop Entry]
Version=1.0
Type=Application
Name=QuickConvert
GenericName=Unit Converter
Comment=Imperial and metric unit converter for engineers
Exec=quickconvert
Icon=com.quickconvert.QuickConvert
Categories=Utility;Calculator;
Keywords=convert;units;metric;imperial;length;weight;temperature;volume;
Terminal=false
StartupNotify=true
StartupWMClass=com.quickconvert.QuickConvert
Actions=show;

[Desktop Action show]
Name=Show QuickConvert
Exec=quickconvert --show
Icon=com.quickconvert.QuickConvert
X-KDE-Shortcuts=Meta+Shift+C
